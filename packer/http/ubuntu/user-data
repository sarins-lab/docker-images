#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  storage:
    layout:
      name: direct
  apt:
    geoip: false
    preserve_sources_list: false
    primary:
      - arches: [amd64, arm64, default]
        uri: http://archive.ubuntu.com/ubuntu
  packages:
    - openssh-server
    - ca-certificates
    - curl
  package_update: true
  package_upgrade: true
  user-data:
    disable_root: true
    users:
      - name: packer
        # SHA-512 hash of "packer-build" — packer user is removed in cleanup provisioner
        passwd: "$6$L22LLQ31Ub0uE5C7$Tt3pwFbmXvzYCajUjhIbJ2Cdi2bQQumhROQJgbGPn4qZ99ItsciypuabHpFTo40Po9rJZ2iM7aletBtkyW1Hp."
        lock-passwd: false
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
  ssh:
    install-server: true
    allow-pw: true
  late-commands:
    - echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/packer
    - chmod 0440 /target/etc/sudoers.d/packer
